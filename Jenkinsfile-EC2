pipeline {
    agent any

    stages {

        stage('EC2 Connection Test') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'EC2_USER'
                    )
                ]) {

                    bat '''
                        ssh -i "%SSH_KEY%" -o StrictHostKeyChecking=no %EC2_USER%@44.201.199.195 "echo Jenkins connected successfully"
                    '''
                }
            }
        }
    }
}
